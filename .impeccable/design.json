  "components": [
    {
      "name": "주 단추",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "먹으로 채운 주 행동 단추. 한 영역에 하나.",
      "html": "<button class=\"ds-btn ds-btn-primary\">기록 쓰기</button>",
      "css": ".ds-btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:2.75rem;padding:0 1rem;border:1.5px solid var(--ink,#1e2228);border-radius:6px;background:var(--paper,#fff);color:var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;font-size:1rem;font-weight:700;line-height:1.2;cursor:pointer;transition:background-color .15s ease,transform .1s ease}.ds-btn-primary{background:var(--ink,#1e2228);color:#fff}.ds-btn-primary:hover{background:#363d45}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:2px}"
    },
    {
      "name": "보조 단추",
      "kind": "button",
      "refersTo": "button",
      "description": "흰 바탕에 1.5px 먹 테두리. 덜 중요한 것은 조용한 선 테두리.",
      "html": "<button class=\"ds-btn2\">이달 모아 보기</button> <button class=\"ds-btn2 ds-quiet\">고치기</button>",
      "css": ".ds-btn2{appearance:none;display:inline-flex;align-items:center;min-height:2.75rem;padding:0 1rem;border:1.5px solid var(--ink,#1e2228);border-radius:6px;background:var(--paper,#fff);color:var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;font-size:1rem;font-weight:700;cursor:pointer;transition:background-color .15s ease,transform .1s ease}.ds-btn2:hover{background:var(--paper-2,#f4f5f7)}.ds-btn2:active{transform:translateY(1px)}.ds-btn2:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:2px}.ds-quiet{border-color:#b9bfc7}"
    },
    {
      "name": "입력칸",
      "kind": "input",
      "refersTo": "input",
      "description": "1.5px 옅은 선 입력칸, 초점에서 파랑.",
      "html": "<input class=\"ds-input\" placeholder=\"내용 찾기\">",
      "css": ".ds-input{min-height:2.75rem;width:18rem;padding:0 .8rem;border:1.5px solid var(--field-line,#868e97);border-radius:6px;background:var(--paper,#fff);color:var(--ink,#1e2228);caret-color:var(--blue,#2d6cb0);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;font-size:1.05rem}.ds-input::placeholder{color:var(--ink-3,#6a727b);opacity:1}.ds-input:focus{border-color:var(--blue,#2d6cb0);outline:2.5px solid rgba(45,108,176,.25);outline-offset:0}"
    },
    {
      "name": "목차",
      "kind": "nav",
      "refersTo": "nav-link-current",
      "description": "괘선 세로 목록, 오른쪽 개수, 지금 화면은 먹 채움.",
      "html": "<ul class=\"ds-nav\"><li><a class=\"ds-nl\" href=\"#\">오늘</a></li><li><a class=\"ds-nl\" href=\"#\" aria-current=\"page\">출결 <span class=\"ds-nb\">1</span></a></li><li><a class=\"ds-nl\" href=\"#\">과제 <span class=\"ds-nb\">2</span></a></li><li><a class=\"ds-nl\" href=\"#\">안내장 <span class=\"ds-nb\">1</span></a></li></ul>",
      "css": ".ds-nav{list-style:none;margin:0;padding:0;width:13rem;border-top:2px solid var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif}.ds-nl{display:flex;align-items:center;justify-content:space-between;min-height:2.6rem;padding:0 .6rem;border-bottom:1px solid var(--rule,#dadde2);color:var(--ink,#1e2228);font-size:1.02rem;font-weight:600;text-decoration:none}.ds-nl:hover{background:var(--paper-2,#f4f5f7)}.ds-nl[aria-current=\"page\"]{background:var(--ink,#1e2228);color:#fff;border-radius:6px;border-bottom-color:transparent}.ds-nb{font-size:.85rem;font-weight:700;color:var(--ink-3,#6a727b);font-variant-numeric:tabular-nums}.ds-nl[aria-current=\"page\"] .ds-nb{color:#d5d9de}.ds-nl:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:2px}"
    },
    {
      "name": "고르기 단추",
      "kind": "chip",
      "refersTo": "seg-option-selected",
      "description": "먹 테두리 안의 4px 칸, 고른 칸은 먹 채움.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">돌림판</button><button>순서 정하기</button><button>모둠 나누기</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:3px;padding:3px;border:1.5px solid var(--ink,#1e2228);border-radius:6px;background:#fff;font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif}.ds-seg button{appearance:none;min-height:2.2rem;padding:0 .85rem;border:0;border-radius:4px;background:none;color:var(--ink,#1e2228);font:inherit;font-weight:700;cursor:pointer}.ds-seg button:hover{background:var(--paper-2,#f4f5f7)}.ds-seg button[aria-pressed=\"true\"]{background:var(--ink,#1e2228);color:#fff}.ds-seg button:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:1px}"
    },
    {
      "name": "시간표 띠",
      "kind": "custom",
      "refersTo": "period-now",
      "description": "교시 칸이 가로로, 지금 교시 먹 채움, 지난 교시 흐림.",
      "html": "<div class=\"ds-tt\"><div class=\"ds-p ds-past\"><span>1교시</span><b>국어</b><i>09:00</i></div><div class=\"ds-p ds-now\"><span>2교시</span><b>수학</b><i>09:50</i></div><div class=\"ds-p\"><span>3교시</span><b>영어</b><i>10:40</i></div><div class=\"ds-p\"><span>4교시</span><b>음악</b><i>11:30</i></div></div>",
      "css": ".ds-tt{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);width:30rem;border-top:2px solid var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif;color:var(--ink,#1e2228)}.ds-p{display:grid;gap:.15rem;padding:.7rem .55rem .8rem;border-right:1px solid var(--rule,#dadde2)}.ds-p:last-child{border-right:0}.ds-p span{font-size:.82rem;font-weight:600;color:var(--ink-3,#6a727b)}.ds-p b{font-size:1.5rem;font-weight:800;letter-spacing:-.02em}.ds-p i{font-style:normal;font-size:.82rem;color:var(--ink-3,#6a727b);font-variant-numeric:tabular-nums}.ds-past b{color:#a9b0b8}.ds-now{background:var(--ink,#1e2228);color:#fff;border-radius:0 0 8px 8px;border-right-color:transparent}.ds-now span,.ds-now i{color:#d5d9de}"
    },
    {
      "name": "도장 체크 칸",
      "kind": "custom",
      "refersTo": "check-cell",
      "description": "이름 칸을 누르면 빨간 작은 도장. 출결 기록 칸은 파란 테와 꼬리표.",
      "html": "<div class=\"ds-board\"><button class=\"ds-cell ds-done\"><span class=\"ds-no\">1</span><span class=\"ds-nm\">김민준</span><span class=\"ds-st\">냄</span></button><button class=\"ds-cell\"><span class=\"ds-no\">2</span><span class=\"ds-nm\">이서연</span><span></span></button><button class=\"ds-cell ds-att\"><span class=\"ds-no\">23</span><span class=\"ds-nm ds-abs\">손현우</span><span class=\"ds-al\">결석·질병</span></button></div>",
      "css": ".ds-board{display:grid;grid-template-columns:repeat(3,10.5rem);gap:.5rem;padding-top:.9rem;border-top:2px solid var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif}.ds-cell{appearance:none;display:grid;grid-template-columns:1.7rem minmax(0,1fr) auto;align-items:center;gap:.4rem;min-height:3.5rem;padding:0 .55rem 0 .4rem;border:1.5px solid var(--rule,#dadde2);border-radius:8px;background:#fff;color:var(--ink,#1e2228);font:inherit;font-size:1.2rem;font-weight:700;text-align:left;cursor:pointer;transition:border-color .15s ease}.ds-cell:hover,.ds-done{border-color:var(--ink,#1e2228)}.ds-cell:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:2px}.ds-no{font-size:.85rem;font-weight:600;color:var(--ink-3,#6a727b);text-align:right}.ds-st{display:inline-grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:50%;border:2.5px solid var(--stamp,#d2392c);color:var(--stamp,#d2392c);font-size:.72rem;font-weight:800;transform:rotate(-12deg);box-shadow:inset 0 0 0 1.5px #fff,inset 0 0 0 2.5px rgba(210,57,44,.5)}.ds-att{border-color:var(--blue,#2d6cb0)}.ds-abs{color:var(--ink-3,#6a727b);text-decoration:line-through;text-decoration-color:var(--blue,#2d6cb0);text-decoration-thickness:2px}.ds-al{font-size:.8rem;font-weight:800;color:var(--blue,#2d6cb0)}"
    },
    {
      "name": "아직 확인할 것 줄",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "D-day 칸, 굵은 제목과 꼬리, 남은 사람, 오른쪽 개수나 다 함 도장.",
      "html": "<ul class=\"ds-todo\"><li><a href=\"#\"><b class=\"ds-w\">D-3</b><span><span class=\"ds-t\">독서록 쓰기<small>과제</small></span><span class=\"ds-who\">못 낸 사람: 양소율 · 손현우 외 1명</span></span><span class=\"ds-c\"><b>21</b>/25</span></a></li><li><a href=\"#\"><b class=\"ds-w\">오늘</b><span><span class=\"ds-t\">아침독서</span><span class=\"ds-who\">모두 읽었어요</span></span><span class=\"ds-done\">다 함</span></a></li></ul>",
      "css": ".ds-todo{list-style:none;margin:0;padding:0;width:28rem;border-top:2px solid var(--ink,#1e2228);font-family:\"Pretendard Variable\",Pretendard,system-ui,sans-serif}.ds-todo a{display:grid;grid-template-columns:4.2rem minmax(0,1fr) auto;align-items:center;gap:.5rem;padding:.6rem .25rem;border-bottom:1px solid var(--rule,#dadde2);color:var(--ink,#1e2228);text-decoration:none}.ds-todo a:hover{background:var(--paper-2,#f4f5f7)}.ds-todo a:focus-visible{outline:2.5px solid var(--blue,#2d6cb0);outline-offset:2px}.ds-w{align-self:start;font-size:1.08rem;line-height:1.55;font-weight:800;font-variant-numeric:tabular-nums}.ds-t{display:block;font-size:1.08rem;line-height:1.55;font-weight:700}.ds-t small{font-size:.8rem;color:var(--ink-3,#6a727b);margin-left:.4rem;font-weight:600}.ds-who{display:block;font-size:.88rem;color:var(--ink-3,#6a727b)}.ds-c{font-size:.95rem;font-weight:600;color:var(--ink-3,#6a727b);font-variant-numeric:tabular-nums}.ds-c b{font-size:1.3rem;font-weight:800;color:var(--ink,#1e2228)}.ds-done{display:inline-grid;place-items:center;width:2.9rem;height:2.9rem;border-radius:50%;border:3px solid var(--stamp,#d2392c);color:var(--stamp,#d2392c);font-size:.78rem;font-weight:800;transform:rotate(-12deg);box-shadow:inset 0 0 0 2px #fff,inset 0 0 0 3px rgba(210,57,44,.5)}"
    },
